						<xs:documentation>Network Border</xs:documentation>
						<xs:documentation>Network border between two neighboring IM's; first or last Primary Location on a network. Attribute of primary location.</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="71">
					<xs:annotation>
						<xs:documentation>State border</xs:documentation>
