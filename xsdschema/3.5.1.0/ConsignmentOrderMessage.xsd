	<xs:element name="ConsignmentOrderType">
		<xs:annotation>
			<xs:documentation>Preliminary list of messages, by now restricted on different types of consignment orders.	
			Message types PRN, NACK, ECN, DEL, INFE, INFP, ECOM, ECOD and ECOU are only used in communication within Raildata ECN members.           
			</xs:documentation>
		</xs:annotation>
