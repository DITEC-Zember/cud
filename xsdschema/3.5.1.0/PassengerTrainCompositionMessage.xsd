				</xs:documentation>
					</xs:annotation>
				</xs:enumeration-->
				<!--xs:enumeration value="53">
					<xs:annotation>
						<xs:documentation>
				Pollution protective plate	Track where floor that avoids pollution of the earth below
				</xs:documentation>
					</xs:annotation>
				</xs:enumeration-->
				<!--xs:enumeration value="55">
