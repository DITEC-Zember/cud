    <build>
        <!-- Konfigurácia na použitie existujúcej štruktúry adresárov -->
        <sourceDirectory>${project.basedir}/JavaSource</sourceDirectory>
        <resources>
            <resource>
                <directory>${project.basedir}/JavaSource/resources</directory>
                <excludes>
                    <exclude>reports/**</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>${project.basedir}/JavaSource</directory>
                <includes>
                    <include>**/*.xml</include>
                    <include>**/*.properties</include>
                </includes>
                <excludes>
                    <exclude>resources/**</exclude>
                    <exclude>logback-test.xml</exclude>
                </excludes>
            </resource>
        </resources>

        <plugins>
            <!-- Maven Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>1.6</source>
                    <target>1.6</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- Maven WAR Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.3.2</version>
                <configuration>
                    <warSourceDirectory>${project.basedir}/WebContent</warSourceDirectory>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                    <!-- Vypnúť vytváranie Maven deskriptora v META-INF/maven -->
                    <archive>
                        <addMavenDescriptor>false</addMavenDescriptor>
                    </archive>
                    <!-- Zahrnúť lokálne JAR súbory do WAR -->
                    <packagingIncludes>
                        **/*,
                        WEB-INF/lib/*.jar
                    </packagingIncludes>
                    <!-- Vylúčiť Torque.properties, logback-test.xml a META-INF/maven z WAR balíka -->
                    <packagingExcludes>
                        WEB-INF/classes/Torque.properties,
                        WEB-INF/classes/logback-test.xml,
                        META-INF/maven/**
                    </packagingExcludes>
                    <webResources>
                        <resource>
                            <directory>${project.basedir}/WebContent</directory>
                        </resource>
                        <!-- Pridať knižnice z AIS projektu -->
                        <resource>
                            <directory>${ais.lib.dir}</directory>
                            <targetPath>WEB-INF/lib</targetPath>
                            <includes>
                                <include>jdbc-c3p0-0.9.5.2.jar</include>
                                <include>mchange-commons-java-0.2.11.jar</include>
                                <include>ditec-c3po.jar</include>
                            </includes>
                        </resource>
                    </webResources>
                </configuration>
            </plugin>

            <!-- Maven Resources Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- Maven Antrun Plugin - kopírovanie a úprava logback.xml z AIS projektu -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>process-logback-config</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <!-- Zmazať logback-test.xml ak existuje -->
                                <delete file="${project.build.directory}/classes/logback-test.xml" 
                                        quiet="true"/>
                                <!-- Kopírovanie logback.xml z AIS projektu -->
                                <copy file="D:/zsr/githubclone/ais/war/logback.xml" 
                                      tofile="${project.build.directory}/classes/logback.xml"
                                      overwrite="true"/>
                                <!-- Nahradenie {kontext} slovom cud v logback.xml -->
                                <replace file="${project.build.directory}/classes/logback.xml"
                                         token="{kontext}" 
                                         value="cud"/>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>process-context-xml</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <!-- Vytvorenie adresára META-INF ak neexistuje -->
                                <mkdir dir="${project.build.directory}/${project.build.finalName}/META-INF"/>
                                <!-- Kopírovanie context.xml z AIS projektu -->
                                <copy file="D:/zsr/githubclone/ais/war/META-INF/context.xml" 
                                      tofile="${project.build.directory}/${project.build.finalName}/META-INF/context.xml"
                                      overwrite="true"/>
                                <!-- Nahradenie {kontext} slovom cud v context.xml -->
                                <replace file="${project.build.directory}/${project.build.finalName}/META-INF/context.xml"
                                         token="{kontext}" 
                                         value="cud"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
