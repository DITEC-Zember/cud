# ============================================================
# TORQUE CONFIGURATION EXAMPLE
# ============================================================
# Toto je len príklad konfigurácie.
# 
# Pre použitie v Jenkins:
# 1. Skopíruj tento súbor na svoje lokálne miesto
# 2. Uprav databázové pripojenie podľa potreby
# 3. Ulož ho na Jenkins server (napr. /var/jenkins_home/configs/Torque.properties)
# 4. Jenkins ho automaticky namountuje do kontajnera
#
# Viac info: docs/TORQUE-CONFIG-SETUP.md
# ============================================================

# Torque Configuration for Server
# Tento súbor sa používa na server-side konfiguráciu databázového pripojenia
# Hodnoty sa môžu prepísať cez environment premenné v Jenkins pipeline

torque.database.APP.adapter=oracle
torque.database.default = APP
torque.dsfactory.APP.factory=org.apache.torque.dsfactory.SharedPoolDataSourceFactory
torque.dsfactory.APP.pool.maxActive=60
torque.dsfactory.APP.pool.testOnBorrow=true
torque.dsfactory.APP.pool.validationQuery=SELECT sysdate from dual

torque.dsfactory.APP.connection.driver = net.sf.log4jdbc.DriverSpy

# DB Connection - tieto hodnoty sa nahrádzajú v Jenkins pipeline
# Pre lokálne testovanie použije dev-oracle19
torque.dsfactory.APP.connection.url = jdbc:log4jdbc:oracle:thin:@(DESCRIPTION = (ADDRESS = (PROTOCOL = TCP)(HOST = dev-oracle19.intra.ditec.sk)(PORT = 1521)) (CONNECT_DATA = (SERVER = DEDICATED) (SERVICE_NAME = zsrdev.intra.ditec.sk)))
torque.dsfactory.APP.connection.user = cud
torque.dsfactory.APP.connection.password = cud
